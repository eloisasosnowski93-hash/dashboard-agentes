# .streamlit/secrets.toml
# Copie este arquivo e preencha com suas credenciais reais
# NUNCA commite este arquivo com dados reais no GitHub!
# Adicione .streamlit/secrets.toml ao .gitignore

# ── IA Anthropic ────────────────────────────────────────────────
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY = ""

# ── Shopee Open Platform ─────────────────────────────────────────
# Obtenha em: https://open.shopee.com → Create App → MEI (Seller)
SHOPEE_PARTNER_ID  = ""        # Número inteiro (ex: 2345678)
SHOPEE_PARTNER_KEY = ""        # String longa (ex: 61e2bfaa1234...)
SHOPEE_SHOP_ID     = ""        # ID da sua loja (número)
SHOPEE_ACCESS_TOKEN= ""        # Token de acesso (renovar a cada 30d)
SHOPEE_TEST_MODE   = "true"    # "true" para sandbox, "false" para produção

# ── Dropi ────────────────────────────────────────────────────────
# Obtenha em: https://dropi.com.br → Integrações → API
DROPI_API_KEY  = ""
DROPI_STORE_ID = ""

# ── WooCommerce (se usar) ────────────────────────────────────────
# Gere em: WP Admin → WooCommerce → Configurações → API REST
WOO_STORE_URL       = ""       # https://sualore.com.br
WOO_CONSUMER_KEY    = ""       # ck_...
WOO_CONSUMER_SECRET = ""       # cs_...

# ── Configurações do scraper ─────────────────────────────────────
SCRAPER_MODE = "demo"          # "demo" ou "real"
